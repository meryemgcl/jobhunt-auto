<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>JobHunt-Auto Platform Intelligence Raporu</title>
  <style>
    :root {
      color-scheme: light dark;
      supported-color-schemes: light dark;
    }
    @media (prefers-color-scheme: dark) {
      body, .bg-body { background-color: #0b0f19 !important; }
      .card-main { background-color: #111827 !important; border-color: #1f2937 !important; }
      .card-sub { background-color: #1a2234 !important; border-color: #2d3748 !important; }
      .text-title { color: #f9fafb !important; }
      .text-body { color: #d1d5db !important; }
      .text-muted { color: #9ca3af !important; }
      .border-light { border-color: #2d3748 !important; }
      .accent-box { background-color: #1e293b !important; border-color: #334155 !important; }
    }
  </style>
</head>
<body class="bg-body" style="margin:0;padding:0;background-color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#1e293b;">

  <!-- Outer wrapper -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9;padding:32px 12px;" class="bg-body">
    <tr><td align="center">
      <!-- Main Container Card -->
      <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" class="card-main" style="max-width:640px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(15,23,42,0.08);border:1px solid #e2e8f0;">

        <!-- ─── HEADER: Executive Intelligence Banner ─────────────────── -->
        <tr>
          <td style="background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#0f766e 100%);padding:36px 36px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td>
                  <div style="font-size:11px;font-weight:700;letter-spacing:1.8px;color:#5eead4;text-transform:uppercase;margin-bottom:8px;">
                    JOBHUNT-AUTO • OTONOM KARİYER İSTİHBARATI
                  </div>
                  <div style="font-size:26px;font-weight:800;color:#ffffff;line-height:1.2;letter-spacing:-0.5px;">
                    Kariyer &amp; Fırsat Bülteni
                  </div>
                  <div style="font-size:13px;color:#94a3b8;margin-top:8px;">
                    🎯 <b style="color:#e2e8f0;">{{ profile.name if profile.name else 'Meryem Güçlü' }}</b> için özel olarak analiz edildi ve derlendi
                  </div>
                </td>
                <td align="right" valign="top" style="width:110px;">
                  <div style="background:rgba(255,255,255,0.08);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:10px 14px;text-align:center;">
                    <div style="font-size:10px;font-weight:600;color:#94a3b8;letter-spacing:1px;text-transform:uppercase;">Tarih</div>
                    <div style="font-size:15px;font-weight:800;color:#ffffff;margin-top:3px;">{{ current_date }}</div>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- ─── METRIC STRIP: At-a-Glance Executive Summary ──────────── -->
        <tr>
          <td class="card-sub" style="background:#f8fafc;padding:12px 36px;border-bottom:1px solid #e2e8f0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-size:12px;color:#64748b;" class="text-muted">
                  <span style="display:inline-block;margin-right:16px;">
                    💼 <strong style="color:#0f172a;" class="text-title">Hedef:</strong> {{ profile.target_skills_label if profile.target_skills_label else (profile.core_skills | join(', ')) }}
                  </span>
                  <span style="display:inline-block;">
                    📍 <strong style="color:#0f172a;" class="text-title">Konum:</strong> {{ profile.preferred_locations | join(' • ') if profile.preferred_locations else 'Uzaktan • Türkiye' }}
                  </span>
                </td>
                <td align="right" style="font-size:11px;">
                  <span style="background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;padding:4px 10px;border-radius:20px;font-weight:700;white-space:nowrap;">
                    ● Sistem Aktif
                  </span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- ─── SKILL GAP & MARKET INSIGHT ────────────────────────────── -->
        {% if skill_gap and skill_gap.summary_text %}
        <tr>
          <td style="padding:24px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:linear-gradient(135deg,#fefce8 0%,#fffbeb 100%);border:1px solid #fde047;border-radius:12px;overflow:hidden;">
              <tr>
                <td style="padding:18px 22px;">
                  <div style="font-size:11px;font-weight:800;letter-spacing:1px;color:#854d0e;text-transform:uppercase;margin-bottom:6px;">
                    📈 Piyasa Yetenek Açığı &amp; Trendler
                  </div>
                  <div style="font-size:13px;color:#713f12;line-height:1.6;margin-bottom:12px;">
                    {{ skill_gap.summary_text }}
                  </div>
                  <div>
                    {% for item in skill_gap.top_market_demands %}
                    <span style="display:inline-block;background:#fef08a;color:#713f12;border:1px solid #facc15;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;margin:3px 6px 3px 0;">
                      ⚡ {{ item.tech }} • {{ item.demand_count }} ilanda talep
                    </span>
                    {% endfor %}
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        <!-- ─── MATCHED JOBS SECTION ─────────────────────────────────── -->
        <tr>
          <td style="padding:28px 36px 0;">
            <!-- Section Header -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:18px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  ⭐ Eşleşen Pozisyonlar &amp; Fırsatlar
                </td>
                <td align="right" style="font-size:12px;color:#64748b;font-weight:700;" class="text-muted">
                  {{ matched_jobs|length }} pozisyon bulundu
                </td>
              </tr>
            </table>

            {% if matched_jobs %}
              {% for job in matched_jobs[:8] %}
              <!-- Individual Job Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);">
                <!-- Visual Priority Score Bar -->
                <tr>
                  <td style="height:4px;background:{% if job.score >= 85 %}linear-gradient(90deg,#7c3aed,#c084fc){% elif job.score >= 70 %}linear-gradient(90deg,#2563eb,#60a5fa){% elif job.score >= 50 %}linear-gradient(90deg,#059669,#34d399){% else %}linear-gradient(90deg,#f59e0b,#fbbf24){% endif %};"></td>
                </tr>
                <tr>
                  <td style="padding:18px 20px;">
                    <!-- Title & Score Badge -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-size:16px;font-weight:800;color:#0f172a;line-height:1.3;" class="text-title">
                          {{ job.title }}
                        </td>
                        <td align="right" valign="top" style="padding-left:14px;white-space:nowrap;">
                          <span style="background:{% if job.score >= 85 %}#7c3aed{% elif job.score >= 70 %}#2563eb{% elif job.score >= 50 %}#047857{% else %}#b45309{% endif %};color:#ffffff;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:800;display:inline-block;">
                            %{{ job.score }} Uyum
                          </span>
                        </td>
                      </tr>
                    </table>

                    <!-- Metadata Strip -->
                    <div style="margin:10px 0 8px;font-size:12px;color:#64748b;line-height:1.5;" class="text-muted">
                      🏢 <strong style="color:#334155;" class="text-title">{{ job.company or 'Şirket Belirtilmemiş' }}</strong> &nbsp;•&nbsp; 
                      📍 {{ job.location or 'Konum Belirtilmemiş' }} &nbsp;•&nbsp; 
                      📅 {{ job.published_at or 'Tarih bilinmiyor' }} ({{ job.freshness_label }}) &nbsp;•&nbsp; 
                      🌐 {{ job.source }}
                    </div>

                    <!-- Match Reasoning Callout -->
                    <div class="accent-box" style="background:#f8fafc;border-left:3px solid {% if job.score >= 85 %}#7c3aed{% elif job.score >= 70 %}#2563eb{% elif job.score >= 50 %}#059669{% else %}#f59e0b{% endif %};border-radius:0 8px 8px 0;padding:10px 14px;font-size:12px;color:#334155;line-height:1.6;margin-bottom:14px;">
                      <strong style="color:#0f172a;" class="text-title">Neden Eşleşti:</strong> {{ job.match_reason }}
                    </div>

                    <!-- Call-to-Action Buttons -->
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="padding-right:10px;">
                          <a href="{{ job.url }}" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:#0f172a;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12px;font-weight:700;letter-spacing:0.3px;">
                            İlanı İncele &rarr;
                          </a>
                        </td>
                        {% if job.application_url and job.application_url != job.url %}
                        <td style="padding-right:10px;">
                          <a href="{{ job.application_url }}" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12px;font-weight:700;letter-spacing:0.3px;">
                            Doğrudan Başvur &rarr;
                          </a>
                        </td>
                        {% endif %}
                        {% if job.score >= 85 %}
                        <td>
                          <span style="display:inline-block;background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;padding:8px 14px;border-radius:8px;font-size:11px;font-weight:800;">
                            ✨ En Yüksek Eşleşme
                          </span>
                        </td>
                        {% elif job.score < 50 %}
                        <td>
                          <span style="display:inline-block;background:#fef3c7;color:#92400e;border:1px solid #fde68a;padding:8px 14px;border-radius:8px;font-size:11px;font-weight:800;">
                            💡 Potansiyel Aday
                          </span>
                        </td>
                        {% endif %}
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
              {% endfor %}
            {% else %}
              <!-- Fallback Zero-Match Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:12px;">
                <tr>
                  <td style="padding:28px;text-align:center;">
                    <div style="font-size:24px;margin-bottom:8px;">🔍</div>
                    <div style="font-size:14px;font-weight:800;color:#0f172a;margin-bottom:8px;" class="text-title">
                      Bugün Eşiği Geçen İlan Bulunamadı
                    </div>
                    <div style="font-size:12px;color:#64748b;line-height:1.6;max-width:440px;margin:0 auto;" class="text-muted">
                      Tüm platformlar tarandı; adayın kriterlerine tam uyan yeni bir ilan henüz yayınlanmamış olabilir. Aşağıdaki açık kaynak ve eğitim fırsatlarını değerlendirebilirsiniz.
                    </div>
                    {% if run_stats %}
                    <div class="accent-box" style="background:#ffffff;border:1px solid #e2e8f0;padding:14px 18px;border-radius:8px;font-size:12px;line-height:1.7;margin-top:16px;text-align:left;display:inline-block;">
                      <strong style="color:#0f172a;" class="text-title">📊 Tarama İstatistikleri:</strong><br>
                      • Taranan Pozisyon Sayısı: <b>{{ run_stats.total_scanned }}</b><br>
                      • Önceden Görülen (Dedup): <b>{{ run_stats.dedup_filtered }}</b><br>
                      • Filtreye Takılan: <b>{{ run_stats.negative_filtered }}</b><br>
                      • En Yüksek Skor: <b>%{{ run_stats.highest_score }}</b> ("{{ run_stats.highest_job_title }}")
                    </div>
                    {% endif %}
                  </td>
                </tr>
              </table>
            {% endif %}
          </td>
        </tr>

        <!-- ─── GITHUB OPEN SOURCE RADAR ──────────────────────────────── -->
        {% if github_issues %}
        <tr>
          <td style="padding:28px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:16px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  🐙 GitHub Açık Kaynak Radarı
                </td>
                <td align="right" style="font-size:11px;color:#64748b;font-weight:600;" class="text-muted">
                  Good First Issues
                </td>
              </tr>
            </table>
            {% for issue in github_issues %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:10px;">
              <tr>
                <td style="padding:14px 18px;">
                  <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:6px;" class="text-title">
                    {{ issue.title }}
                  </div>
                  <div style="font-size:11px;color:#64748b;" class="text-muted">
                    <span style="background:#e2e8f0;color:#334155;padding:3px 8px;border-radius:4px;font-weight:700;">
                      {{ issue.repo }}
                    </span>
                    &nbsp;•&nbsp; {{ issue.created_at }}
                    &nbsp;•&nbsp; 
                    <a href="{{ issue.url }}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;font-weight:700;text-decoration:none;">
                      Katkı Ver &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <!-- ─── BOOTCAMPS & CAMPS ─────────────────────────────────────── -->
        {% if camps %}
        <tr>
          <td style="padding:28px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:16px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  🎓 Ücretsiz Eğitim Kampları &amp; Akademi
                </td>
              </tr>
            </table>
            {% for camp in camps %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:10px;">
              <tr>
                <td style="padding:14px 18px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="font-size:13px;font-weight:700;color:#0f172a;" class="text-title">{{ camp.title }}</td>
                      <td align="right">
                        <span style="background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;">
                          {{ camp.status }}
                        </span>
                      </td>
                    </tr>
                  </table>
                  <div style="font-size:11px;color:#64748b;margin-top:6px;" class="text-muted">
                    {{ camp.platform }} &nbsp;•&nbsp; 
                    <a href="{{ camp.url }}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;font-weight:700;text-decoration:none;">
                      Başvuru ve Detaylar &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <!-- ─── R&D / TUBITAK CALLS ───────────────────────────────────── -->
        {% if rd_projects %}
        <tr>
          <td style="padding:28px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:16px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  🔬 AR-GE &amp; TÜBİTAK Proje Destekleri
                </td>
              </tr>
            </table>
            {% for project in rd_projects %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:10px;">
              <tr>
                <td style="padding:14px 18px;">
                  <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:4px;" class="text-title">{{ project.title }}</div>
                  {% if project.description %}
                  <div style="font-size:12px;color:#475569;line-height:1.5;margin-bottom:8px;" class="text-body">{{ project.description }}</div>
                  {% endif %}
                  <div style="font-size:11px;color:#64748b;" class="text-muted">
                    {{ project.source }} &nbsp;•&nbsp; 
                    <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;font-weight:700;text-decoration:none;">
                      Çağrı Detayları &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <!-- ─── HACKATHONS ────────────────────────────────────────────── -->
        {% if hackathons %}
        <tr>
          <td style="padding:28px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:16px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  🏆 Yarışmalar &amp; Hackathonlar
                </td>
              </tr>
            </table>
            {% for hackathon in hackathons %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card-sub" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:10px;">
              <tr>
                <td style="padding:14px 18px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="font-size:13px;font-weight:700;color:#0f172a;" class="text-title">{{ hackathon.title }}</td>
                      <td align="right">
                        <span style="background:#ecfdf5;color:#065f46;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;">
                          {{ hackathon.status }}
                        </span>
                      </td>
                    </tr>
                  </table>
                  <div style="font-size:11px;color:#64748b;margin-top:6px;" class="text-muted">
                    {{ hackathon.platform }} &nbsp;•&nbsp; 
                    <a href="{{ hackathon.url }}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;font-weight:700;text-decoration:none;">
                      Katıl &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <!-- ─── TECH NEWS ─────────────────────────────────────────────── -->
        {% if news %}
        <tr>
          <td style="padding:28px 36px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:2px solid #0f172a;padding-bottom:10px;margin-bottom:16px;" class="border-light">
              <tr>
                <td style="font-size:14px;font-weight:800;color:#0f172a;text-transform:uppercase;letter-spacing:0.8px;" class="text-title">
                  📰 Güncel Teknoloji Haberleri
                </td>
              </tr>
            </table>
            {% for item in news %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:1px solid #f1f5f9;margin-bottom:8px;" class="border-light">
              <tr>
                <td style="padding:8px 0 8px 12px;border-left:3px solid #cbd5e1;">
                  <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:3px;" class="text-title">{{ item.title }}</div>
                  <div style="font-size:11px;color:#64748b;" class="text-muted">
                    {{ item.source }} &nbsp;•&nbsp; 
                    <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;font-weight:700;text-decoration:none;">
                      Haberi Oku &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <!-- ─── FOOTER ────────────────────────────────────────────────── -->
        <tr>
          <td style="padding:32px 36px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#0f172a;border-radius:12px;overflow:hidden;">
              <tr>
                <td style="padding:24px 28px;text-align:center;">
                  <div style="font-size:13px;font-weight:800;color:#ffffff;letter-spacing:0.5px;margin-bottom:6px;">
                    JobHunt-Auto • Otonom Kariyer Zekası
                  </div>
                  <div style="font-size:11px;color:#94a3b8;line-height:1.6;">
                    Bu bülten otonom motor tarafından <b>{{ profile.name if profile.name else 'Meryem Güçlü' }}</b> için derlenmiştir.<br>
                    Çok Kaynaklı Eşzamanlı Tarama • Bağlamsal Eşleştirme • Otomatik Arşivleme
                  </div>
                  <div style="margin-top:14px;">
                    <a href="https://github.com/meryemgcl/jobhunt-auto" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:rgba(255,255,255,0.1);color:#5eead4;border:1px solid rgba(255,255,255,0.2);padding:6px 14px;border-radius:6px;font-size:11px;font-weight:700;text-decoration:none;">
                      GitHub Proje Sayfası &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
