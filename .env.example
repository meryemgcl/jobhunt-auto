# ==============================================================================
# JobHunt-Auto Environment Variables Template
# ==============================================================================

# SMTP E-Mail Configuration (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
USER_EMAIL_TO=

# Required when the optional API is deployed. Clients must send:
# X-Jobhunt-Token: your_random_trigger_token
JOBHUNT_API_TOKEN=

# Optional integrations
GITHUB_TOKEN=
N8N_WEBHOOK_URL=

# Network resilience
JOBHUNT_HTTP_TIMEOUT=10
JOBHUNT_MAX_JOB_AGE_DAYS=30
JOBHUNT_USER_AGENT=JobHunt-Auto/1.0 (+https://github.com/meryemgcl/jobhunt-auto)

# Runtime diagnostics
JOBHUNT_LOG_LEVEL=INFO
JOBHUNT_RUN_ID=
JOBHUNT_DB_PATH=jobhunt.db
# Optional persistent PostgreSQL store. If set, this takes precedence over SQLite.
DATABASE_URL=
JOBHUNT_DATABASE_SSLMODE=require
